# Optional overrides for docker compose. Copy to .env to use; every value has a working default.

# Only applies when the database volume is first created. To change it later, run
# "docker compose down --volumes" first (this deletes the data), or the API can no longer log in.
POSTGRES_PASSWORD=lumen-dev-password

WEB_PORT=8080
HARBOR_PORT=8081
KESTREL_PORT=8082

# Telemetry (optional). Uncomment both lines so that "docker compose up" also starts the Aspire dashboard
# (http://localhost:18888) and the API sends it traces, metrics and logs. Left commented, nothing is exported.
# COMPOSE_PROFILES=observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
DASHBOARD_PORT=18888
