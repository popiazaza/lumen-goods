# .NET
bin/
obj/
*.user
*.suo
.vs/
TestResults/
*.trx
coverage*/

# Node / Angular
node_modules/
dist/
.angular/
*.tsbuildinfo
npm-debug.log*

# Local data and secrets. SQLite files are matched by extension, never by a "data/" folder rule:
# git on Windows/macOS ignores case, so such a rule would also hide source folders named "Data".
.env
*.db
*.db-shm
*.db-wal

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Vendor-specific agent files (this repo uses AGENTS.md and .agents/ only)
CLAUDE.md
CLAUDE.local.md
.claude/

# OS
.DS_Store
Thumbs.db
