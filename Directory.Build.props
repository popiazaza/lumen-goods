<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same behaviour on a dev machine and in the containers: no culture data, so number parsing
         must be explicit (Kestrel's "1.249,00" is parsed with an explicit NumberFormatInfo). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- A business rule filter (the filter-trait option with "BR=BR-PAY-05") matches tests in only some projects; the
         others would fail the whole run with exit code 8, "zero tests ran". A failing or erroring test still fails it.
         (No double hyphen in this comment: XML forbids it.) -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
